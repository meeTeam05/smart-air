{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/run-hook.sh SessionStart sh .codex/hooks/session-start.sh",
            "statusMessage": "Loading planning context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/run-hook.sh UserPromptSubmit sh .codex/hooks/user-prompt-submit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/run-hook.sh PreToolUse python3 .codex/hooks/pre_tool_use.py",
            "statusMessage": "Checking plan before Bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/run-hook.sh PostToolUse python3 .codex/hooks/post_tool_use.py",
            "statusMessage": "Reviewing Bash against plan"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .codex/hooks/run-hook.sh Stop python3 .codex/hooks/stop.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
