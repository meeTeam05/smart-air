menu "Smart Air Configuration"

    config FIRMWARE_VERSION
        string "Firmware version"
        default "1.0.0"
        help
            Version string included in MQTT status messages and OTA validation.

    config SA_PROV_NAME_PREFIX
        string "BLE provisioning name prefix"
        default "PROV"
        help
            The advertised BLE name will be <prefix>_<6-hex-MAC-suffix>.

    config SA_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtts://mqtt.minhnhat05.xyz:8883"
        help
            Full URI of the EMQX broker reachable from the ESP32.
            Use the public raw MQTT hostname that resolves to the server and
            forwards TCP 8883 to EMQX. This is separate from the Cloudflare
            HTTP/WSS ingress used by the API and mobile app.
            Runtime override source: NVS namespace "device", key "broker_uri".

    config SA_WIFI_CONNECT_TIMEOUT_MS
        int "Wi-Fi connection timeout (ms)"
        default 30000
        range 5000 120000
        help
            Maximum time to wait for an IP address after esp_wifi_connect().

    config SA_PROV_TIMEOUT_MS
        int "BLE provisioning timeout (ms)"
        default 300000
        range 30000 600000
        help
            Maximum time to wait for the app to complete BLE provisioning.
            If the app disconnects mid-flow and never reconnects, provisioning
            fails after this timeout instead of hanging indefinitely.

    config SA_MQTT_SECRET_KEY
        string "MQTT secret key"
        default ""
        help
            Per-device secret for MQTT authentication. Sensitive — do not commit.
            Leave empty in repository builds; the current server returns the
            real secret_key once from POST /api/devices and provisioning writes
            it to NVS before the device can login to MQTT.
            Override at runtime via NVS namespace "device", key "secret_key".

    config SA_CONFIG_SELF_TEST
        bool "Enable NVS config self-test on boot"
        default n
        help
            When enabled, config_self_test() runs at startup to verify NVS
            write/read roundtrip. Disable in production.

    config SA_HTTPD_PORT
        int "HTTP server port"
        default 80
        range 1 65535
        help
            TCP port for the device's built-in HTTP API server.

    config SA_DEMO_NO_PERIPHERALS
        bool "Demo no peripherals"
        default n
        help
            Enable demo mode when no physical peripheral is connected.
            In this mode, firmware feeds telemetry from an internal virtual
            sample array while preserving the normal MQTT/TLS/auth flow,
            topics, command handling, and telemetry/shadow JSON schema.
            This mode is intended for ESP32-S3-DevKit-C-6R8 demos without
            sensors, display, relay, buzzer, LED, SD card, or RTC hardware.

    config SA_SENSOR_POLLING_INTERVAL
        int "Sensor Polling Interval Seconds"
        default 5
        range 1 60
        help
            Telemetry/shadow polling interval in seconds for normal and demo
            modes. The current server API and app dashboards expect frequent
            demo telemetry; 5 seconds is the recommended local/demo value.

    menu "Peripheral Enable/Disable"

        config SA_ENABLE_SHT3X
            bool "Enable SHT3x temperature/humidity sensor"
            default y
            help
                When disabled, SHT3x is not initialized and temperature/humidity
                fields in telemetry JSON are null.

        config SA_ENABLE_DS3231
            bool "Enable DS3231 RTC"
            default y
            help
                When disabled, DS3231 is not initialized. Telemetry timestamps
                fall back to system time. The MQTT set_time command still
                updates the ESP32 system clock, but it is not persisted through
                power loss without RTC hardware.

        config SA_ENABLE_ILI9225
            bool "Enable ILI9225 display"
            default n
            help
                When disabled, display initialization and drawing are skipped.

        config SA_ENABLE_SD_CARD
            bool "Enable SD card logging"
            default n
            help
                When disabled, SD card initialization and logging are skipped.

        config SA_ENABLE_CO_SENSOR
            bool "Enable GM-702B CO gas sensor"
            default n
            help
                When disabled, CO sensor is not initialized and co_ppm fields
                in telemetry JSON are null.

        config SA_ENABLE_NO2_SENSOR
            bool "Enable GM-102B NO2 gas sensor"
            default n
            help
                When disabled, NO2 sensor is not initialized and no2_ppm fields
                in telemetry JSON are null.

        config SA_ENABLE_RELAYS
            bool "Enable relay outputs"
            default n
            help
                When disabled, relay GPIOs are not configured and relay control
                commands are ignored.

        config SA_ENABLE_BUZZER
            bool "Enable buzzer"
            default n
            help
                When disabled, buzzer initialization and tone generation are skipped.

        config SA_ENABLE_LED
            bool "Enable WS2812 RGB LED"
            default y
            help
                When disabled, led_init() and led_set_state() become no-ops.
                All LED status feedback is suppressed.

        config SA_ENABLE_FACTORY_RESET
            bool "Enable factory reset button"
            default y
            help
                When disabled, the factory reset button task is not started.
                The button GPIO is not configured.

    endmenu

    # I2C Bus
    menu "I2C Bus (SHT3x + DS3231)"

        config SA_I2C_SDA_PIN
            int "I2C SDA GPIO"
            default 4
            range 1 48
            help
                GPIO for I2C SDA. Shared bus for SHT3x (0x44) and DS3231 (0x68).
                Requires 4.7K external pull-up resistor.
                AVOID: 0,3 (strapping), 19-20 (USB), 26-32 (flash/PSRAM),
                33-37 (PSRAM octal), 43-46 (UART/strapping).

        config SA_I2C_SCL_PIN
            int "I2C SCL GPIO"
            default 5
            range 1 48
            help
                GPIO for I2C SCL. Shared bus for SHT3x and DS3231.
                Requires 4.7K external pull-up resistor.
                Must be different from SDA pin.

        config SA_I2C_FREQ_HZ
            int "I2C FREQ HZ"
            default 400000
            range 400000 400000
            help
                HW-01: fixed 400 kHz — do not change

        config SA_I2C_TIMEOUT_MS
            int "I2C operation timeout (ms)"
            default 1000
            range 100 5000
            help
                Timeout for I2C read/write operations in milliseconds.

    endmenu

    # Display SPI
    menu "Display SPI (SPI2_HOST — ILI9225)"

        config SA_DISP_CLK_PIN
            int "Display CLK GPIO"
            default 1
            range 1 48
            help
                SPI2_HOST clock for ILI9225 display (10 MHz).

        config SA_DISP_SDA_PIN
            int "Display SDA (MOSI) GPIO"
            default 2
            range 1 48
            help
                SPI2_HOST data out for ILI9225 display.

        config SA_DISP_RS_PIN
            int "Display RS (Data/Command) GPIO"
            default 42
            range 1 48
            help
                ILI9225 register select. HIGH = data, LOW = command.

        config SA_DISP_RST_PIN
            int "Display RST GPIO"
            default 41
            range 1 48
            help
                ILI9225 hardware reset (active low).

        config SA_DISP_CS_PIN
            int "Display CS GPIO"
            default 40
            range 1 48
            help
                ILI9225 chip select (active low).

    endmenu

    # SD Card SPI
    menu "SD Card SPI (SPI3_HOST)"

        config SA_SD_MISO_PIN
            int "SD Card MISO GPIO"
            default 38
            range 1 48
            help
                SPI3_HOST data in from SD card.
                Separate SPI host from display — different SPI mode.

        config SA_SD_SCK_PIN
            int "SD Card SCK GPIO"
            default 39
            range 1 48
            help
                SPI3_HOST clock for SD card.

        config SA_SD_MOSI_PIN
            int "SD Card MOSI GPIO"
            default 40
            range 1 48
            help
                SPI3_HOST data out to SD card.

        config SA_SD_CS_PIN
            int "SD Card CS GPIO"
            default 41
            range 1 48
            help
                SD card chip select (active low).

    endmenu

    # Analog Sensors
    menu "Analog Sensors (ADC1 — WiFi safe)"

        config SA_CO_ANALOG_PIN
            int "CO sensor analog GPIO"
            default 1
            range 1 10
            help
                ADC1 input for CO gas sensor analog output.
                MUST be GPIO 1-10 (ADC1). ADC2 (GPIO 11-20) is unavailable
                when WiFi is active — do not use ADC2 pins here.

        config SA_NO2_ANALOG_PIN
            int "NO2 sensor analog GPIO"
            default 2
            range 1 10
            help
                ADC1 input for NO2 gas sensor analog output.
                MUST be GPIO 1-10 (ADC1). Must differ from CO pin.

    endmenu

    # Relay Outputs
    menu "Relay Outputs"

        config SA_RELAY_1_PIN
            int "Relay 1 GPIO"
            default 17
            range 1 48
            help
                GPIO output for relay channel 1. Active high.

        config SA_RELAY_2_PIN
            int "Relay 2 GPIO"
            default 18
            range 1 48
            help
                GPIO output for relay channel 2. Active high.

        config SA_RELAY_3_PIN
            int "Relay 3 GPIO"
            default 21
            range 1 48
            help
                GPIO output for relay channel 3. Active high.

    endmenu

    # Single-pin peripherals

    config SA_BUZZER_PIN
        int "Buzzer GPIO"
        default 6
        range 1 48
        help
            GPIO for buzzer output. Uses LEDC PWM for tone generation.

    config SA_LED_PIN
        int "RGB LED GPIO (WS2812)"
        default 48
        range 1 48
        help
            GPIO for WS2812 RGB LED. Uses RMT peripheral.
            GPIO 48 = onboard LED on ESP32-S3-DevKitC-1.

    config SA_FACTORY_RESET_PIN
        int "Factory reset button GPIO"
        default 7
        range 1 48
        help
            GPIO for factory reset button. Active-low with internal pull-up.
            Hold for SA_FACTORY_RESET_HOLD_MS to trigger full NVS erase + reboot.
            AVOID GPIO 0 (strapping pin — causes download mode on reset).

    config SA_FACTORY_RESET_HOLD_MS
        int "Factory reset hold duration (ms)"
        default 5000
        range 3000 10000
        help
            How long the button must be held to trigger factory reset.
            LED blinks red after 1s of holding as user feedback.

endmenu
