# Copy to .env and fill in values — .env is gitignored, never commit it

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=smartair
POSTGRES_USER=smartair
POSTGRES_PASSWORD=changeme_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password_here

# ── EMQX dashboard ────────────────────────────────────────────────────────────
EMQX_DASHBOARD_PASSWORD=changeme_emqx_dashboard_password

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme_grafana_admin_password

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@smartair.local
PGADMIN_PASSWORD=changeme_pgadmin_password

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Steps to get the token:
#   1. https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
#   2. Create tunnel → name it "smart-air-pi"
#   3. Under "Public Hostname", add:
#      - Subdomain: <blank>, Domain: yourdomain.com, Service: http://sa-nginx:80
#      - Subdomain: mqtt, Domain: yourdomain.com, Service: http://sa-nginx:80
#   4. Copy the tunnel token from the install command shown
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# API service (server/api)
# The docker-compose api service reads this same server/.env file.

# API listen port inside container
PORT=3000

# PostgreSQL connection from API container
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis connection from API container
REDIS_HOST=redis
REDIS_PORT=6379

# JWT / sessions
JWT_SECRET=generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# EMQX admin API used by server/api
EMQX_API_URL=http://emqx:18083
EMQX_API_USER=admin
EMQX_API_PASSWORD=changeme_emqx_dashboard_password

# EMQX MQTT bridge used by server/api
EMQX_MQTT_URL=mqtt://emqx:1883
EMQX_MQTT_USER=sa-server
EMQX_MQTT_PASSWORD=changeme_sa_server_password
