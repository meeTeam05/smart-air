# Copy to .env and fill in values — .env is gitignored, never commit it

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=smartair
POSTGRES_USER=smartair
POSTGRES_PASSWORD=changeme_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password_here

# ── EMQX ──────────────────────────────────────────────────────────────────────
# EMQX dashboard password. This is not used by server/api for REST Admin API auth.
EMQX_DASHBOARD_PASSWORD=changeme_emqx_dashboard_password
# EMQX REST API key/secret. Must match server/emqx/api-key.bootstrap:
#   smart-air-api:<same-secret>:administrator
EMQX_API_KEY=smart-air-api
EMQX_API_SECRET=generate_with_openssl_rand_hex_32
# Node cookie — generate with: openssl rand -hex 32
EMQX_NODE_COOKIE=generate_with_openssl_rand_hex_32
# Host bind for MQTT/TLS 8883. Set to the Ubuntu LAN IP for ESP32 access.
MQTT_LAN_BIND_IP=192.168.1.16

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=changeme_grafana_admin_password

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@smartair.local
PGADMIN_PASSWORD=changeme_pgadmin_password

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Domain: minhnhat05.xyz (registered on Namecheap)
# Steps to get the token:
#   1. cloudflare.com → Add site → minhnhat05.xyz → Free plan
#      Note the two Cloudflare nameservers shown (e.g. alice.ns.cloudflare.com)
#   2. Namecheap → Domain List → minhnhat05.xyz → Nameservers → Custom DNS
#      Enter both Cloudflare nameservers → Save (propagation: up to 24h)
#   3. Cloudflare → Zero Trust → Networks → Tunnels → Create a tunnel
#      Name: smart-air-pi → Save → choose Docker connector
#   4. Under "Public Hostname" tab, add these routes:
#      - Subdomain: <blank>, Domain: minhnhat05.xyz, Service: http://sa-nginx:80
#      - Subdomain: www,     Domain: minhnhat05.xyz, Service: http://sa-nginx:80
#   5. Copy the tunnel token from the docker run command shown (long string after --token)
#   6. Paste it below, then on the Pi: docker compose up -d cloudflared
#
# What this exposes via https://minhnhat05.xyz :
#   /api/*      → REST API (Fastify)
#   /api/realtime → App realtime stream (SSE over API auth)
#   /grafana/   → Grafana dashboards
#   /mqtt       → MQTT over WebSocket for broker clients
#   /ota/       → OTA firmware files (browser download; ESP32 OTA still uses local IP)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# API service (server/api)
# The docker-compose api service reads this same server/.env file.

# REQUIRED at runtime for server/api startup — process.exit(1) if missing:
#   JWT_SECRET, POSTGRES_PASSWORD, REDIS_PASSWORD,
#   EMQX_API_KEY, EMQX_API_SECRET, EMQX_MQTT_PASSWORD
JWT_SECRET=generate_with_openssl_rand_hex_32
EMQX_MQTT_PASSWORD=changeme_sa_server_password

# OPTIONAL for server/api (safe defaults exist)

# API listen port inside container
PORT=3000
LOG_LEVEL=info
BODY_LIMIT_BYTES=65536

# PostgreSQL connection from API container
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
PG_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=10000

# Redis connection from API container
REDIS_HOST=redis
REDIS_PORT=6379

# JWT / sessions
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_REUSE_MARKER_SWEEP_INTERVAL_MS=3600000

# EMQX admin API used by server/api
EMQX_API_URL=http://emqx:18083
EMQX_API_TIMEOUT_MS=5000

# EMQX MQTT bridge used by server/api
EMQX_MQTT_URL=mqtt://emqx:1883
EMQX_MQTT_USER=sa-server
MQTT_PUBLISH_TIMEOUT_MS=5000
MQTT_PROVISION_RETRY_MS=5000

# API realtime stream
REALTIME_REPLAY_LIMIT=1000
REALTIME_HEARTBEAT_MS=25000
REALTIME_EVENT_RETENTION_HOURS=24
REALTIME_EVENT_RETENTION_SWEEP_INTERVAL_MS=3600000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (defaults to production domain)
CORS_ORIGINS=https://minhnhat05.xyz
